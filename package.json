{
  "name": "naseej-pos",
  "version": "1.0.0",
  "description": "Naseej Distribution — offline-first retail POS and inventory desktop app",
  "main": "out/main/index.js",
  "author": "Naseej",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-builder",
    "prepackage:mac": "node scripts/prepare-sharp-platform.mjs darwin arm64 && node scripts/prepare-sharp-platform.mjs darwin x64",
    "package:mac": "electron-builder --mac",
    "prepackage:win": "node scripts/prepare-sharp-platform.mjs win32 x64",
    "package:win": "electron-builder --win",
    "prepackage:linux": "node scripts/prepare-sharp-platform.mjs linux x64",
    "package:linux": "electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@fontsource/nunito-sans": "^5.2.7",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-virtual": "^3.14.4",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.1.7",
    "framer-motion": "^12.40.0",
    "fs-extra": "^11.2.0",
    "i18next": "^26.2.0",
    "lucide-react": "^0.378.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.42",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.2.0",
    "eslint": "^9.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^4.1.8"
  }
}
